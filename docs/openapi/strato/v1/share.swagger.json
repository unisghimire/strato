      },
      "description": "PageResponse accompanies every list response."
    },
    "v1Permission": {
      "type": "string",
      "enum": [
        "PERMISSION_UNSPECIFIED",
        "PERMISSION_VIEWER",
        "PERMISSION_EDITOR",
        "PERMISSION_OWNER"
      ],
      "default": "PERMISSION_UNSPECIFIED",
      "description": "Permission granted by a share.\n\n - PERMISSION_VIEWER: read metadata + download\n - PERMISSION_EDITOR: viewer + upload new versions\n - PERMISSION_OWNER: editor + reshare + delete"
