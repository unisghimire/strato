# Copy to .env for docker-compose. NEVER commit real secrets.

# --- Postgres ---
STRATO_POSTGRES_HOST=postgres
STRATO_POSTGRES_PORT=5432
STRATO_POSTGRES_USER=strato
STRATO_POSTGRES_PASSWORD=strato-dev-password
STRATO_POSTGRES_DATABASE=strato

# --- Redis ---
STRATO_REDIS_ADDR=redis:6379
STRATO_REDIS_PASSWORD=

# --- MinIO / S3 ---
STRATO_S3_ENDPOINT=minio:9000
STRATO_S3_ACCESS_KEY=strato-minio
STRATO_S3_SECRET_KEY=strato-minio-secret
STRATO_S3_BUCKET=strato-blobs
STRATO_S3_USE_SSL=false

# --- Auth ---
# Generate: openssl rand -base64 48
STRATO_AUTH_JWT_SECRET=change-me-openssl-rand-base64-48
STRATO_AUTH_ACCESS_TOKEN_TTL=15m
STRATO_AUTH_REFRESH_TOKEN_TTL=720h

# --- Encryption ---
# Master KEK, 32 bytes base64. Generate: openssl rand -base64 32
STRATO_ENCRYPTION_MASTER_KEY=change-me-openssl-rand-base64-32

# --- Observability ---
STRATO_TELEMETRY_OTLP_ENDPOINT=jaeger:4317
