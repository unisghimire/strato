{
  "title": "Strato Overview",
  "uid": "strato-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "RPC rate by method",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (method) (rate(strato_rpc_duration_seconds_count[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "RPC p95 latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(strato_rpc_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (non-OK)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (code) (rate(strato_rpc_duration_seconds_count{code!=\"OK\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Transfer throughput",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "expr": "rate(strato_upload_bytes_total[5m])", "legendFormat": "upload" },
        { "expr": "rate(strato_download_bytes_total[5m])", "legendFormat": "download" }
      ]
    },
    {
      "id": 5,
      "title": "In-flight RPCs",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "strato_rpc_in_flight" }]
    },
    {
      "id": 6,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "go_goroutines" }]
    }
  ]
}
